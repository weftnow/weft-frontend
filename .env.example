# Copy to .env.local for development. Both are SERVER-ONLY:
# never prefix them NEXT_PUBLIC_, or the backend URL and shared secret
# would be inlined into the browser bundle.

# Where weft_core is reachable. Locally: uvicorn weft.api:app --reload
WEFT_API_URL=http://localhost:8000

# Shared secret sent as X-Weft-Proxy-Key. Must match WEFT_PROXY_KEY in
# weft_core. Leave empty locally -- the backend skips the check when unset.
WEFT_PROXY_KEY=

# FastAPI event/questionnaire backend. Server-only; never NEXT_PUBLIC_.
WEFT_B2B_API_URL=http://localhost:8000

# Development/test mock only. Ignored in production.
WEFT_FAST_QUESTIONS_DEV_SECONDS=

# Where Fast Questions AND event feedback get their state -- one variable, one
# decision, so a room running on the real backend can never have its feedback
# land in a mock. "backend" drives both from WEFT_B2B_API_URL; "mock" uses
# simulated state and is the default outside production. An explicit value wins
# in every environment, so set "backend" locally to work against a running
# weft-b2b-backend.
#
# Production must choose deliberately: blank or unset there stops the server at
# boot rather than silently serving simulated data. Set it in the hosting
# environment -- do not ship this file's value.
WEFT_CONVERSATION_SOURCE=mock
